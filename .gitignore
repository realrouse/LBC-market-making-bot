# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Credentials — never commit
config.json
inventory.toml
**/mexc*.env
.git-credentials*

# LBCMM local
.venv/
*.egg-info/

# Private AI context — contains infrastructure details, keep local only
docs/CONTEXT_AI.md

# Claude Code guidance file — contains infrastructure rules and private context, keep local only
CLAUDE.md

# Integration test configuration — contains server addresses and passwords
scripts/test_multibot.conf

# Fleet topology — describes THIS deployment's real accounts/bots/real-money flags, keep
# local only. Committed: inventory.toml.example — copy it to inventory.toml and edit it.
inventory.toml

# Generated bot identities — runtime state, one per deployed instance, never commit
# (a committed bot_id would be adopted by every account and collide across the fleet)
bot_id_*

# Local notes — may contain infrastructure details (server names, IPs), never commit
*.txt
!docs/*.txt
!requirements.txt
!requirements-dev.txt
!requirements-lbcmm.txt

# Claude Code local settings — may contain server addresses and credentials
.claude/settings.local.json

# Vim swap files
*.swp
*.swo

# Claude Code internal files
.claude/scheduled_tasks.lock

# Runtime artifacts
*.log
*.db
.coverage
notes/audit170526.md
# Python build artifacts (a `pip install <pkg>/` from the repo drops these in the source tree)
build/
*.egg-info/

# backtest / analysis databases + generated reports (runtime artifacts, never source)
data/
reports/
