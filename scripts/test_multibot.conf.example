# tradinebotte — multibot integration test configuration
#
# Copy this file to ~/.tradinebotte-test.conf and fill in your values:
#   cp scripts/test_multibot.conf.example ~/.tradinebotte-test.conf
#   editor ~/.tradinebotte-test.conf
#
# Or point to a custom location:
#   TEST_MULTIBOT_CONF=/path/to/conf bash scripts/test_multibot_deploy.sh
#
# The file is sourced as bash, so standard bash syntax applies.

# ─── SSH target server ─────────────────────────────────────────────────────────
TEST_SERVER="myserver.example.com"
TEST_PORT="22"

# ─── Test accounts ─────────────────────────────────────────────────────────────
# All arrays below must have the same length.
# Roles: user1=feed+bot, user2=bot, user3=grid standalone, user4=scalping, user5=swing
TEST_USERS=(user1 user2 user3 user4 user5)
TEST_PASSWORDS=(pass1 pass2 pass3 pass4 pass5)

# ─── Role assignments (indices into TEST_USERS) ────────────────────────────────
#
# Feed owner: runs the systemd tradinebotte-feed service.
# account_bot on this host also uses feed_auto_start=false (systemd manages it).
TEST_FEED_USER_IDX=0

# Account bot users: run account_bot.py in multibot mode (feed_auto_start=false).
# Must include the feed owner index if that host also runs an account_bot.
TEST_ACCOUNT_USER_IDXS=(0 1)

# Standalone user: runs live_bot.py in standalone mode (grid strategy, update_standalone.sh).
TEST_STANDALONE_USER_IDX=2

# Scalping user: runs scalping_bot.py (three concurrent strategies, update_scalping.sh).
# TEST_SCALPING_USER_IDX=3

# Swing user: runs live_bot.py with swing strategy (update_swing.sh).
TEST_SWING_USER_IDX=4

# ─── Feed address ──────────────────────────────────────────────────────────────
# ZeroMQ PUB address where the feed service listens. All account bots on the
# same server share this address. Default: tcp://127.0.0.1:5557.
# TEST_FEED_ADDR="tcp://127.0.0.1:5557"

# ─── Feed service auto-restart ─────────────────────────────────────────────────
# When true: if feed.py changed since last deploy, the script attempts
#   sudo tradinebotte-ctl restart tradinebotte-feed   (NOPASSWD via /etc/sudoers.d/tradinebotte).
# When false (default): the script prints the commands and leaves them to you.
TEST_FEED_AUTO_RESTART=false

# ─── Shared indicator service config ──────────────────────────────────────────
# The indicators service is a SINGLE shared process on the machine, started
# under the feed owner user (TEST_FEED_USER_IDX). Set the path (relative to
# REMOTE_INSTALL_DIR) to the indicators JSON config file. Leave unset or empty
# to skip the indicators service entirely.
#
# Each account_bot registers the streams it needs at startup via the REP socket
# declared in its own config.json (indicators_reg_addr + indicators_streams).
# TEST_INDICATORS_CONFIG="strategies/indicators_base.json"

# ─── Optional overrides ────────────────────────────────────────────────────────
# Duration of the sustained-operation phase (seconds). Default: 180.
# Can also be overridden on the command line: --duration 300
# TEST_DURATION=180

# Remote directories on the test server. Defaults work for most setups.
# TEST_REMOTE_INSTALL_DIR=~/tradinebotte   # where the bot code is deployed
# TEST_REMOTE_BOT_DIR=~/account-sim        # runtime dir for each bot (TRADINEBOTTE_DIR)
