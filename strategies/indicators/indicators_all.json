            "_comment": "Binance spot L2 orderbook + trade stream — scalping microstructure",
            "id":         "btc_scalping_spot",
            "asset":      "BTCUSDT",
            "source":     "binance_scalping",
            "timeframe":  "tick",
            "indicators": [],
            "params": {
                "market":          "spot",
                "obi_levels":      10,
                "obi_ema_alpha":   0.05,
                "tfi_window_s":    60,
                "vol_window_n":    200,
