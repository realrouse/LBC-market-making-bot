{
    "_comment": "tradinebotte unified indicator service — all BTC streams in one process",

    "zmq_feed_addr": "tcp://127.0.0.1:5557",
    "zmq_out_addr":  "tcp://127.0.0.1:5559",
    "zmq_reg_addr":  "tcp://127.0.0.1:5561",
    "min_ticks": 25,

    "streams": [

        {
            "_comment": "4h BTC/USDT candles — RSI(14) + EMA(50/200) + ATR(14) + volatility(20)",
            "id":           "btc_4h",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "4h",
            "seed_periods": 250,
            "indicators": [
                { "type": "rsi",        "period": 14 },
                { "type": "ema",        "period": 50 },
                { "type": "ema",        "period": 200 },
                { "type": "atr",        "period": 14 },
                { "type": "volatility", "period": 20 }
            ]
        },

        {
            "_comment": "1d BTC/USDT candles — RSI(14) + volatility(20)",
            "id":           "btc_1d",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "1d",
            "seed_periods": 50,
            "indicators": [
                { "type": "rsi",        "period": 14 },
                { "type": "volatility", "period": 20 }
            ]
        },

        {
            "_comment": "Binance perpetual funding rate — polled every 15 min",
            "id":              "btc_funding",
            "asset":           "BTCUSDT",
            "source":          "binance_funding",
            "timeframe":       "n/a",
            "indicators":      [],
