{
    "_name": "Long-Term BTC Cycle Strategy — Grid V1",
    "_description": "Macro cycle-aware allocation strategy. BULL regime: accumulate to 90% BTC, buy on drawbacks. BEAR regime: reduce to 10% BTC, sell on rebounds. Regime transitions driven by Mayer Multiple and Pi Cycle Top indicator. Backtested on 9yr BTCUSDT 1m 2017-2026 daily aggregated: ×24.0 return vs ×18.0 buy-and-hold (+33.8%), CAGR 43.8%, MaxDD 81.4%, Calmar 0.54. 4 regime transitions over 8.8yr.",
    "_backtest": {
        "db":              "data/BTCUSDT3197d_20172026.db  (2017-08-17 → 2026-05-19, 4.6M candles 1m)",
        "aggregation":     "1m → daily OHLCV (day high for top signals, day low for bottom signals)",
        "regime_transitions": [
            "2019-06-26  BULL→BEAR  $13,094  (Mayer high > 2.4)",
            "2019-11-21  BEAR→BULL  $7,628   (Mayer low < 0.8)",
            "2021-01-02  BULL→BEAR  $32,178  (Mayer high > 2.4)",
            "2021-05-19  BEAR→BULL  $36,690  (Mayer low < 0.8)"
        ],
        "result":          "×24.0 return  CAGR 43.8%  MaxDD 81.4%  Calmar 0.54",
        "vs_buy_and_hold": "×18.0 return  CAGR 39.1%  MaxDD 83.2%  Calmar 0.47  (+33.8%)",
        "avg_sell_price":  33680,
        "avg_buy_price":   16547,
        "trades":          168,
        "calibrated_at":   "2026-05-21  BTC≈$76,947",
        "current_regime":  "BULL (since 2021-05-19)"
    },
    "_run_backtest": "python3 scripts/backtest_cycle_strategy.py data/BTCUSDT3197d_20172026.db",
    "_run_indicators": "python3 scripts/analyze_btc_cycles.py data/BTCUSDT3197d_20172026.db",

    "strategy_type": "longtermcycle",
    "connector":     "binance",
    "symbol":        "BTCUSDT",

    "capital_start":     10000.0,
    "btc_alloc_start":   0.50,

    "regime": {
        "initial":       "bull",
        "target_bull":   0.90,
        "target_bear":   0.10,
        "min_bull_days": 180,
        "min_bear_days": 60
    },

    "top_signals": {
        "_comment": "Any one fires after min_bull_days in BULL → switch to BEAR",
        "mayer_multiple_high_threshold": 2.4,
        "pi_cycle_top": {
            "enabled": true,
            "fast_ma": 111,
            "slow_ma": 350,
            "slow_multiplier": 2
        }
    },

    "bottom_signals": {
        "_comment": "Any one fires after min_bear_days in BEAR → switch to BULL",
        "mayer_multiple_low_threshold": 0.8,
        "price_below_200_week_sma": {
            "enabled": true,
            "period":  1400
        }
    },

    "execution": {
        "_comment": "In BEAR: sell on rebounds. In BULL: buy on drawbacks.",
        "rebound_pct":   0.05,
        "drawback_pct":  0.05,
        "tranche_frac":  0.25,
        "fee_rate":      0.001
    },

    "daily_stop_loss": 0
}
