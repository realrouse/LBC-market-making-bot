[Unit]
Description=tradinebotte — Polymarket BTC 5-min trading bot
Documentation=https://github.com/neofutur/tradinebotte
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Environment=TRADINEBOTTE_DIR=__TRADINEBOTTE_DIR__
EnvironmentFile=-__TRADINEBOTTE_DIR__/credentials
WorkingDirectory=__TRADINEBOTTE_DIR__
ExecStart=__TRADINEBOTTE_DIR__/venv/bin/python3 __TRADINEBOTTE_DIR__/live_bot.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
