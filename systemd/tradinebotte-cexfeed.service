[Unit]
# Shared CEX market-data feed (data plane). Runs on the infra account (acct-1, index 0 in TEST_USERS).
# One public WS per exchange (Binance BTCUSDT + MEXC BTC_USDT), rebroadcast over
# ZMQ. Consumed cross-account over TCP loopback by the grid/swing bots
# (data_source=cex_feed). NOTE: cex_feed imports tradinetools.PORT_CEX_FEED — the
# host's venv site-packages tradinetools must be current before (re)starting this.
Description=tradinebotte — shared CEX market-data feed (Binance + MEXC, TCP :5563)
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/tradinebotte
Environment=TRADINEBOTTE_CEX_FEED_ADDR=tcp://127.0.0.1:5563
Environment=TRADINEBOTTE_CEX_FEEDS=binance:BTCUSDT,mexc:BTCUSDT,mexc:LBCUSDT,mexc_futures:BTC_USDT
ExecStart=%h/tradinebotte/.venv/bin/python3 %h/tradinebotte/cex_feed.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
