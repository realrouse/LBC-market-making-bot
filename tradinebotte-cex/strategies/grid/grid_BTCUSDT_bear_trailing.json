        "trail_mode":    "bear (re-center downward only)",
        "sweep":         "RANGES=[10,15,20,25,30] × LEVELS=[20,30,40] — all 15 combos positive",
        "best_calmar":   "±30% / 40 levels → +15.0% PnL / MaxDD 9% / Calmar 1.69",
        "best_pnl":      "±25% / 40 levels → +15.7% PnL / MaxDD 11% / Calmar 1.44",
        "current_config":"±30% / 40 levels (best Calmar)",
        "calibrated_at": "2026-05-20  BTC≈$76,883"
