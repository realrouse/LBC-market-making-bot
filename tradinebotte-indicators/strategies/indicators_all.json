{
    "_comment": "tradinebotte unified indicator service — all BTC streams in one process",

    "zmq_feed_addr": "tcp://127.0.0.1:5557",
    "zmq_out_addr":  "tcp://127.0.0.1:5559",
    "zmq_reg_addr":  "tcp://127.0.0.1:5561",
    "min_ticks": 25,

    "streams": [

        {
            "_comment": "4h BTC/USDT candles — RSI(14) + EMA(50/200) + ATR(14) + volatility(20)",
            "id":           "btc_4h",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "4h",
            "seed_periods": 250,
            "indicators": [
                { "type": "rsi",        "period": 14 },
                { "type": "ema",        "period": 50 },
                { "type": "ema",        "period": 200 },
                { "type": "atr",        "period": 14 },
                { "type": "volatility", "period": 20 }
            ]
        },

        {
            "_comment": "1d BTC/USDT candles — RSI(14) + volatility(20)",
            "id":           "btc_1d",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "1d",
            "seed_periods": 50,
            "indicators": [
                { "type": "rsi",        "period": 14 },
                { "type": "volatility", "period": 20 }
            ]
        },

        {
            "_comment": "1d Ichimoku cloud — trend filter for the swing bot. Own stream (never co-located on btc_1d) because the publisher suppresses a stream's whole message while any indicator is None, and the cloud needs 78 bars. seed >= 78.",
            "id":           "btc_1d_ichimoku",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "1d",
            "seed_periods": 90,
            "indicators": [
                { "type": "ichimoku" }
            ]
        },

        {
            "_comment": "4h Ichimoku cloud — trend filter for the accumulation bot (more responsive than daily). Own stream, seed >= 78 (78 x 4h ~ 13 days of REST seed candles).",
            "id":           "btc_4h_ichimoku",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "4h",
            "seed_periods": 90,
            "indicators": [
                { "type": "ichimoku" }
            ]
        },

        {
            "_comment": "1w Ichimoku cloud — long-term (macro) trend filter. Publishes only on weekly close; the applicable cloud needs 78 weeks of history so seed >= 78 (~1.5 years of REST seed candles).",
            "id":           "btc_1w_ichimoku",
            "asset":        "BTCUSDT",
            "source":       "binance_ws",
            "timeframe":    "1w",
            "seed_periods": 90,
            "indicators": [
                { "type": "ichimoku" }
            ]
        },

        {
            "_comment": "Binance perpetual funding rate — polled every 15 min",
            "id":              "btc_funding",
            "asset":           "BTCUSDT",
            "source":          "binance_funding",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 900
        },

        {
            "_comment": "Deribit DVOL implied volatility index — polled every 5 min",
            "id":              "btc_dvol",
            "asset":           "BTC",
            "source":          "deribit_iv",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 300
        },

        {
            "_comment": "Alternative.me Fear & Greed Index — polled every hour",
            "id":              "fear_greed",
            "asset":           "",
            "source":          "fear_greed",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 3600
        },

        {
            "_comment": "Binance futures open interest — polled every 5 min",
            "id":              "btc_oi",
            "asset":           "BTCUSDT",
            "source":          "binance_oi",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 300
        },

        {
            "_comment": "Binance top-trader long/short ratio — polled every 5 min",
            "id":              "btc_ls_ratio",
            "asset":           "BTCUSDT",
            "source":          "binance_ls_ratio",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 300
        },

        {
            "_comment": "Binance futures forced liquidations — aggregated every 5 min",
            "id":              "btc_liquidations",
            "asset":           "BTCUSDT",
            "source":          "binance_liquidations",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 300
        },

        {
            "_comment": "Binance spot L2 orderbook + trade stream — scalping microstructure",
            "id":         "btc_scalping_spot",
            "asset":      "BTCUSDT",
            "source":     "binance_scalping",
            "timeframe":  "tick",
            "indicators": [],
            "params": {
                "market":          "spot",
                "obi_levels":      10,
                "obi_ema_alpha":   0.05,
                "tfi_window_s":    60,
                "vol_window_n":    200,
                "publish_every_n": 10
            }
        },

        {
            "_comment": "Binance perp L2 orderbook + trade stream — scalping microstructure",
            "id":         "btc_scalping_perp",
            "asset":      "BTCUSDT",
            "source":     "binance_scalping",
            "timeframe":  "tick",
            "indicators": [],
            "params": {
                "market":          "perp",
                "obi_levels":      10,
                "obi_ema_alpha":   0.05,
                "tfi_window_s":    60,
                "vol_window_n":    200,
                "publish_every_n": 10
            }
        },

        {
            "_comment": "Full spot OB — 5000 levels via snapshot+diff; OBI 10/100/500, walls, cum vol",
            "id":         "btc_full_depth",
            "asset":      "BTCUSDT",
            "source":     "binance_full_depth",
            "timeframe":  "tick",
            "indicators": [],
            "params": {
                "obi_levels_list":   [10, 100, 500],
                "cum_vol_range_pct": 1.0,
                "wall_range_pct":    2.0,
                "publish_every_n":   10
            }
        },

        {
            "_comment": "VWAP context filter — 4h VWAP vs current price; dip_score = (vwap-price)/vwap",
            "id":              "btc_vwap_context",
            "asset":           "BTCUSDT",
            "source":          "binance_vwap_context",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 3600,
            "params": {
                "vwap_period": 24,
                "timeframe":   "4h"
            }
        },

        {
            "_comment": "Volume profile — 24h taker buy/sell by $500 bucket; identifies HVN zones",
            "id":              "btc_volume_profile",
            "asset":           "BTCUSDT",
            "source":          "binance_volume_profile",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 3600,
            "params": {
                "bucket_size_usd": 500,
                "hvn_top_n":       5,
                "kline_limit":     288,
                "timeframe":       "5m"
            }
        },

        {
            "_comment": "Macro OBI — 1h of 1m candles taker flow; trend-direction filter",
            "id":              "btc_macro_obi",
            "asset":           "BTCUSDT",
            "source":          "binance_macro_obi",
            "timeframe":       "n/a",
            "indicators":      [],
            "poll_interval_s": 60,
            "params": {
                "kline_limit":       60,
                "ema_alpha":         0.20,
                "neutral_threshold": 0.10,
                "timeframe":         "1m"
            }
        }

    ]
}
