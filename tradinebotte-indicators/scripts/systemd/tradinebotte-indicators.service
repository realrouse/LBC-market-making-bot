[Unit]
Description=tradinebotte — Unified indicator service (__LABEL__)
Documentation=https://github.com/neofutur/tradinebotte/blob/main/docs/multi.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Environment=TRADINEBOTTE_INDICATORS_ADDR=__IND_ADDR__
Environment=TRADINEBOTTE_INDICATORS_REG_ADDR=__REG_ADDR__
EnvironmentFile=-__ENV_FILE__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__VENV__/bin/python3 __BOT_DIR__/indicators.py --config __CONFIG_FILE__
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
